NODE_ENV=development
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OWNER_SETUP_KEY=replace-with-a-random-one-time-owner-setup-key
ENCRYPTION_KEY=replace-with-64-hex-characters
SUPABASE_STORAGE_BUCKET=post-media
SCHEDULER_ENABLED=true
META_GRAPH_API_VERSION=v22.0
X_API_BASE_URL=https://api.x.com/2
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional outside Render; Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=
# Only needed when the local Vite frontend runs on a different port.
FRONTEND_URL=http://localhost:5173
